<?xml version="1.0" encoding="UTF-8"?>
<!-- 运行日志：本地文件，保留 7 天（02 Q7）；只用于故障排查，禁止记录密码、App Secret、访问令牌、Authorization 请求头 -->
<configuration>
  <springProperty scope="context" name="LOG_DIR" source="qd.logging.dir" defaultValue="./logs"/>
  <springProperty scope="context" name="LOG_DAYS" source="qd.logging.retention-days" defaultValue="7"/>
  <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Shanghai} %-5level [%thread] %logger{20} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/qd-assistant.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/qd-assistant.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>${LOG_DAYS}</maxHistory>
    </rollingPolicy>
    <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
